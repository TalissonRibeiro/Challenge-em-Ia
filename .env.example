# Copie este arquivo para ".env" e preencha com sua chave da API do Google Gemini.
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=coloque_sua_chave_aqui

# Opcional: modelos utilizados (valores padrão já funcionam)
EMBEDDING_MODEL=models/text-embedding-004
GENERATIVE_MODEL=gemini-2.0-flash

# Porta em que a aplicação Flask vai rodar
PORT=8080
